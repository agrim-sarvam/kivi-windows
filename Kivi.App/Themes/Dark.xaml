<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canon DARK palette — a Canon-over-KDS override (NOT a dimmed light palette).
         Byte-exact from Kivi.Core/DesignTokens/Tokens.cs (§2.1). -->
    <Color x:Key="CanvasColor">#0C0E0C</Color>
    <Color x:Key="Surface1Color">#161616</Color>
    <Color x:Key="Surface2Color">#1E1E1E</Color>
    <Color x:Key="InkPrimaryColor">#E9E7DD</Color>
    <Color x:Key="InkSecondaryColor">#A7A99E</Color>
    <Color x:Key="InkTertiaryColor">#84887D</Color>
    <Color x:Key="AccentColor">#8FCE6E</Color>
    <Color x:Key="AccentWashColor">#148FCE6E</Color>
    <Color x:Key="HairlineColor">#14FFFFFF</Color>
    <Color x:Key="AnnotationColor">#D8B85C</Color>
    <Color x:Key="StateListeningColor">#F8A86C</Color>
    <Color x:Key="StateProcessingColor">#788CFF</Color>
    <Color x:Key="StateSettledColor">#8FCE6E</Color>
    <Color x:Key="StateErrorColor">#B81514</Color>
    <Color x:Key="WarmTintColor">#404948</Color>

    <SolidColorBrush x:Key="Canvas" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="InkPrimary" Color="{StaticResource InkPrimaryColor}" />
    <SolidColorBrush x:Key="InkSecondary" Color="{StaticResource InkSecondaryColor}" />
    <SolidColorBrush x:Key="InkTertiary" Color="{StaticResource InkTertiaryColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentWash" Color="{StaticResource AccentWashColor}" />
    <SolidColorBrush x:Key="Hairline" Color="{StaticResource HairlineColor}" />
    <SolidColorBrush x:Key="Annotation" Color="{StaticResource AnnotationColor}" />
    <SolidColorBrush x:Key="StateListening" Color="{StaticResource StateListeningColor}" />
    <SolidColorBrush x:Key="StateProcessing" Color="{StaticResource StateProcessingColor}" />
    <SolidColorBrush x:Key="StateSettled" Color="{StaticResource StateSettledColor}" />
    <SolidColorBrush x:Key="StateError" Color="{StaticResource StateErrorColor}" />
    <SolidColorBrush x:Key="WarmTint" Color="{StaticResource WarmTintColor}" />

    <SolidColorBrush x:Key="RankGold" Color="#D8B85C" />
    <SolidColorBrush x:Key="RankSilver" Color="#B7BAB0" />
    <SolidColorBrush x:Key="RankBronze" Color="#C88E5A" />

    <sys:Boolean xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="IsDarkMood">True</sys:Boolean>
</ResourceDictionary>

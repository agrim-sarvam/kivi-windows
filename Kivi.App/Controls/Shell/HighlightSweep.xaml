<UserControl x:Class="Kivi.App.Controls.Shell.HighlightSweep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The canonical highlighter contour, traced from PageHeader.tsx (viewBox 100x30,
         preserveAspectRatio="none" => Stretch=Fill so it deforms to its frame). -->
    <Viewbox Stretch="Fill">
        <Canvas Width="100" Height="30">
            <Path x:Name="Blob"
                  Fill="{Binding Fill, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Data="M2 16 C7 9 22 8 43 9 C64 10 83 8 98 12 C99 18 98 24 96 27 C77 29 54 30 33 29 C19 28 6 29 3 25 C1 22 1 19 2 16 Z" />
        </Canvas>
    </Viewbox>
</UserControl>

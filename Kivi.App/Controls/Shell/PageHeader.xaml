<UserControl x:Class="Kivi.App.Controls.Shell.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Kivi.App.Controls.Shell">
    <!-- WorkspacePageHeader: marque(30) title over accent-wash highlight sweep + subtitle.
         44px top inset, 24px bottom (owner supplies outer padding; here just bottom gap). -->
    <StackPanel Margin="0,0,0,24">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Grid>
                <!-- sweep behind, height 12, slight rotate + horizontal overscale -->
                <shell:HighlightSweep x:Name="Sweep"
                                      Fill="{DynamicResource AccentWash}"
                                      Height="12" VerticalAlignment="Bottom"
                                      Margin="-2,0,-2,1">
                    <shell:HighlightSweep.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.08" CenterX="0" />
                            <RotateTransform Angle="-1.4" />
                            <TranslateTransform Y="3" />
                        </TransformGroup>
                    </shell:HighlightSweep.RenderTransform>
                </shell:HighlightSweep>
                <TextBlock x:Name="TitleText" Style="{StaticResource Marque}"
                           FontWeight="Medium" Padding="2,0" />
            </Grid>
        </StackPanel>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Subtitle}" Margin="0,8,0,0"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>

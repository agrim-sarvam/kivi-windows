    </Compile>
    <Compile Update="Views\Onboarding\WalkthroughPage.xaml.cs">
      <DependentUpon>WalkthroughPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Onboarding\ConfigPage.xaml.cs">
      <DependentUpon>ConfigPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\MainAppWindow.xaml.cs">
      <DependentUpon>MainAppWindow.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\SidebarNavItem.xaml.cs">
      <DependentUpon>SidebarNavItem.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\RecordPage.xaml.cs">
      <DependentUpon>RecordPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\HistoryPage.xaml.cs">
      <DependentUpon>HistoryPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\AnalyticsPage.xaml.cs">
      <DependentUpon>AnalyticsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\SettingsPage.xaml.cs">
      <DependentUpon>SettingsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\PersonasPage.xaml.cs">
      <DependentUpon>PersonasPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\PresetsPage.xaml.cs">
      <DependentUpon>PresetsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Views\MainApp\MemoryPage.xaml.cs">
      <DependentUpon>MemoryPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

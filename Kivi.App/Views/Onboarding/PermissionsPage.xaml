<!-- Kivi.App/Views/Onboarding/PermissionsPage.xaml -->
<Page
    x:Class="Kivi.App.Views.Onboarding.PermissionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kivi.App.Controls"
    Background="{ThemeResource KiviSurfaceAltBrush}">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{ThemeResource KiviSurfaceBrush}"
                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource KiviRadiusLg}"
                Width="420"
                Padding="40,40,40,32">
            <StackPanel Spacing="0">
                <controls:KiviOrbControl Width="60" Height="81" HorizontalAlignment="Center" State="Idle"/>

                <TextBlock Text="two permissions, then you talk" HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="{ThemeResource KiviFontFamily}"
                           FontSize="{ThemeResource KiviFontSizeTitle}"
                           FontWeight="{ThemeResource KiviFontWeightSemibold}"
                           Foreground="{ThemeResource KiviTextPrimaryBrush}"
                           Margin="0,20,0,0"/>
                <TextBlock Text="kivi types where your cursor is — that needs the same access your keyboard has. Nothing is read, only written."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{ThemeResource KiviFontFamily}"
                           FontSize="{ThemeResource KiviFontSizeBody}"
                           Foreground="{ThemeResource KiviTextSecondaryBrush}"
                           Margin="0,8,0,0"/>

                <!-- Microphone row -->
                <Grid Margin="0,32,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="18"
                              Foreground="{ThemeResource KiviTextSecondaryBrush}"
                              VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Microphone" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        <TextBlock Text="to hear you" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeCaption}"
                                   Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <FontIcon x:Name="MicChipIcon" Glyph="&#xE73E;" FontSize="14"
                                  Foreground="{ThemeResource KiviPositiveBrush}"/>
                        <TextBlock x:Name="MicChip" Text="checking…" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviPositiveBrush}"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}" Margin="0,20,0,20"/>

                <!-- Screen context row (Windows: informational, auto-granted — UIA needs no OS permission grant) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18"
                              Foreground="{ThemeResource KiviTextSecondaryBrush}"
                              VerticalAlignment="Top" Margin="0,2,16,0"/>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Screen context" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        <TextBlock Text="reads the active app &amp; field to match tone" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeCaption}"
                                   Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource KiviPositiveBrush}"/>
                        <TextBlock Text="granted" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviPositiveBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Hotkey badge -->
                <Border HorizontalAlignment="Center" Margin="0,32,0,0"
                        Background="{ThemeResource KiviSurfaceAltBrush}"
                        BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                        CornerRadius="{ThemeResource KiviRadiusMd}"
                        Padding="20,14">
                    <TextBlock Text="Right Ctrl" FontFamily="{ThemeResource KiviMonoFontFamily}"
                               FontSize="{ThemeResource KiviFontSizeBody}"
                               Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                </Border>
                <TextBlock Text="next: hold Right Ctrl and say anything — we'll polish it live"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{ThemeResource KiviMonoFontFamily}"
                           FontSize="{ThemeResource KiviFontSizeCaption}"
                           Foreground="{ThemeResource KiviTextTertiaryBrush}"
                           Margin="0,12,0,0"/>

                <StackPanel x:Name="OpenSettingsLink" Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <HyperlinkButton Click="OnOpenSettings" Content="Open microphone settings"/>
                    <HyperlinkButton Click="OnRecheck" Content="Recheck"/>
                </StackPanel>

                <Button x:Name="ContinueButton" Click="OnContinue" IsEnabled="False"
                        HorizontalAlignment="Stretch" Margin="0,24,0,0"
                        Style="{StaticResource KiviPrimaryButtonStyle}"
                        Content="Continue"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

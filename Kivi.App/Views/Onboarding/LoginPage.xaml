<!-- Kivi.App/Views/Onboarding/LoginPage.xaml -->
<Page
    x:Class="Kivi.App.Views.Onboarding.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kivi.App.Controls"
    Background="{ThemeResource KiviSurfaceAltBrush}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Width="300">
        <controls:KiviOrbControl x:Name="Mark" Width="76" Height="103" HorizontalAlignment="Center" State="Idle"/>

        <!-- Wordmark: Space Grotesk 500, -4% tracking, green 'i's (brand spec). -->
        <TextBlock HorizontalAlignment="Center" Margin="0,20,0,0"
                   FontFamily="{ThemeResource KiviWordmarkFontFamily}"
                   FontSize="{StaticResource KiviFontSizeDisplay}"
                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                   CharacterSpacing="-40">
            <Run Foreground="{ThemeResource KiviTextPrimaryBrush}">k</Run><Run Foreground="{ThemeResource KiviAccentBrush}">i</Run><Run Foreground="{ThemeResource KiviTextPrimaryBrush}">v</Run><Run Foreground="{ThemeResource KiviAccentBrush}">i</Run>
        </TextBlock>

        <TextBlock Text="for windows" HorizontalAlignment="Center"
                   FontFamily="{ThemeResource KiviMonoFontFamily}" FontSize="{ThemeResource KiviFontSizeCaption}"
                   Foreground="{ThemeResource KiviTextTertiaryBrush}" Margin="0,2,0,0"/>

        <TextBlock Text="Your voice, polished." HorizontalAlignment="Center"
                   FontFamily="{ThemeResource KiviFontFamily}" FontSize="{ThemeResource KiviFontSizeBody}"
                   Foreground="{ThemeResource KiviTextSecondaryBrush}" Margin="0,8,0,0"/>

        <Button x:Name="GoogleButton" Click="OnGoogle" Margin="0,40,0,0"
                HorizontalAlignment="Stretch"
                Style="{StaticResource KiviPrimaryButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="48" Height="48">
                        <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <Path Fill="#FBBC05" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <Path Fill="#34A853" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Continue with Google" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <HyperlinkButton x:Name="EmailButton" Click="OnEmail" HorizontalAlignment="Center"
                         Content="Use work email instead" Margin="0,16,0,0"
                         FontFamily="{ThemeResource KiviFontFamily}"
                         Foreground="{ThemeResource KiviTextSecondaryBrush}"/>

        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontFamily="{ThemeResource KiviFontFamily}" FontSize="{ThemeResource KiviFontSizeCaption}"
                   Foreground="{ThemeResource KiviTextSecondaryBrush}" Margin="0,16,0,0"
                   Visibility="Collapsed"/>

        <TextBlock Text="free &amp; unlimited during launch — your words stay yours"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontFamily="{ThemeResource KiviMonoFontFamily}"
                   FontSize="{ThemeResource KiviFontSizeCaption}" Foreground="{ThemeResource KiviTextTertiaryBrush}"
                   Margin="0,28,0,0"/>

        <TextBlock Text="Powered by Sarvam AI"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   FontFamily="{ThemeResource KiviMonoFontFamily}"
                   FontSize="{ThemeResource KiviFontSizeCaption}" Foreground="{ThemeResource KiviTextTertiaryBrush}"
                   Margin="0,10,0,0"/>
    </StackPanel>
</Page>

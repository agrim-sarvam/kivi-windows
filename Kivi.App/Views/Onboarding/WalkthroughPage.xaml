<!-- Kivi.App/Views/Onboarding/WalkthroughPage.xaml -->
<Page
    x:Class="Kivi.App.Views.Onboarding.WalkthroughPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource KiviSurfaceAltBrush}">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{ThemeResource KiviSurfaceBrush}"
                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                CornerRadius="{ThemeResource KiviRadiusLg}"
                Width="460"
                Padding="40,40,40,32">
            <StackPanel Spacing="0">
                <TextBlock Text="let's try it" HorizontalAlignment="Center" TextAlignment="Center"
                           FontFamily="{ThemeResource KiviFontFamily}"
                           FontSize="{ThemeResource KiviFontSizeTitle}"
                           FontWeight="{ThemeResource KiviFontWeightSemibold}"
                           Foreground="{ThemeResource KiviTextPrimaryBrush}"/>

                <TextBlock x:Name="StatusChip" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontFamily="{ThemeResource KiviFontFamily}"
                           FontSize="{ThemeResource KiviFontSizeBody}"
                           Foreground="{ThemeResource KiviTextSecondaryBrush}"
                           Margin="0,8,0,24"/>

                <!-- Step 1: hold-to-talk practice -->
                <StackPanel x:Name="Step1Panel" Spacing="12">
                    <TextBlock Text="Hold Right Ctrl and say something into the box below."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{ThemeResource KiviFontFamily}"
                               FontSize="{ThemeResource KiviFontSizeCaption}"
                               Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <TextBox x:Name="PracticeField"
                             PlaceholderText="Your dictated text will appear here…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="96"
                             Background="{ThemeResource KiviSurfaceAltBrush}"
                             BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                             CornerRadius="{ThemeResource KiviRadiusSm}"
                             Foreground="{ThemeResource KiviTextPrimaryBrush}"
                             FontFamily="{ThemeResource KiviFontFamily}"
                             Padding="16,10"/>
                </StackPanel>

                <!-- Step 2: hands-free practice -->
                <StackPanel x:Name="Step2Panel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Double-tap Right Ctrl to start hands-free mode, then tap again to stop."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{ThemeResource KiviFontFamily}"
                               FontSize="{ThemeResource KiviFontSizeCaption}"
                               Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                </StackPanel>

                <!-- Step 3: the Right Alt key (English / translate mode) -->
                <StackPanel x:Name="Step3Panel" Spacing="12" Visibility="Collapsed">
                    <Border Background="{ThemeResource KiviSurfaceAltBrush}"
                            BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                            CornerRadius="{ThemeResource KiviRadiusSm}" Padding="16,14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="One more key: Right Alt"
                                       FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightSemibold}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock TextWrapping="Wrap"
                                       FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"
                                       Text="Right Ctrl types what you say. Right Alt translates it to English as you speak — say something in Hindi, Marathi, Tamil, any language, and it comes out in English. Hold it to talk, or double-tap for hands-free, exactly like Right Ctrl."/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Hold Right Alt and say something in another language to try it."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{ThemeResource KiviFontFamily}"
                               FontSize="{ThemeResource KiviFontSizeCaption}"
                               Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <TextBox x:Name="PracticeFieldAlt"
                             PlaceholderText="Your English translation will appear here…"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="96"
                             Background="{ThemeResource KiviSurfaceAltBrush}"
                             BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                             CornerRadius="{ThemeResource KiviRadiusSm}"
                             Foreground="{ThemeResource KiviTextPrimaryBrush}"
                             FontFamily="{ThemeResource KiviFontFamily}"
                             Padding="16,10"/>
                </StackPanel>

                <Button x:Name="ContinueButton" Content="Continue" Click="OnContinue"
                        HorizontalAlignment="Stretch" Margin="0,24,0,0"
                        Style="{StaticResource KiviPrimaryButtonStyle}"/>

                <HyperlinkButton x:Name="SkipLink" Click="OnSkip" Content="Skip"
                                 HorizontalAlignment="Center" Margin="0,12,0,0"
                                 FontFamily="{ThemeResource KiviFontFamily}"
                                 Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

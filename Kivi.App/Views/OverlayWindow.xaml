<!-- Kivi.App/Views/OverlayWindow.xaml -->
<!-- Invisible: this WinUI window only anchors app lifetime; the visible orb is a separate
     Win32 layered window (Controls/LayeredOrb) because WinUI can't render a transparent,
     free-floating, glowing shape. Also hosts the system tray icon (TaskbarIcon), since this
     window is the existing cross-cutting anchor for orb/main-app-window lifetime concerns. -->
<Window
    x:Class="Kivi.App.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">
    <Grid>
        <!-- Installed H.NotifyIcon.WinUI 2.3.2's own ContextMenuFlyout property is a
             private auto-property (not a public DP) in this version, so the menu is set
             via the standard inherited FrameworkElement.ContextFlyout attached property
             instead (TaskbarIcon : FrameworkElement), which TaskbarIcon reads internally
             for ShowContextMenu. Right-click (MenuActivation default) opens it. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                         ToolTipText="Kivi"
                         IconSource="ms-appx:///Assets/Icons/kivi-mask.png">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Kivi" Click="OnTrayOpenKivi" />
                    <MenuFlyoutItem x:Name="TrayPauseItem" Text="Pause dictation" Click="OnTrayPauseToggle" />
                    <MenuFlyoutItem Text="Settings" Click="OnTraySettings" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit Kivi" Click="OnTrayQuit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Window>

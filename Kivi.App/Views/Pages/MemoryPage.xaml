<UserControl x:Class="Kivi.App.Views.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Kivi.App.Controls.Shell">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1068" Margin="44,0,44,96">
            <StackPanel>
                <shell:PageHeader Margin="0,44,0,0" Title="dictionary" />

                <!-- explainer card -->
                <Border Background="{DynamicResource Surface1}" CornerRadius="14"
                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="words kivi " FontFamily="{DynamicResource FontBody}" FontSize="20"
                                       Foreground="{DynamicResource InkPrimary}" VerticalAlignment="Center" />
                            <Grid>
                                <shell:HighlightSweep Fill="{DynamicResource AccentWash}" Height="12"
                                                      VerticalAlignment="Bottom" Margin="-2,0,-2,1" />
                                <TextBlock Text="never misspells." FontFamily="{DynamicResource FontBody}" FontSize="20"
                                           Foreground="{DynamicResource InkPrimary}" Padding="2,0" />
                            </Grid>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="you say" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="&#x201C;aditya shatriya&#x201D;" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource FontSerif}" FontStyle="Italic" FontSize="17"
                                           Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                            <shell:InkArrow Grid.Column="1" Width="72" Foreground="{DynamicResource Accent}"
                                            VerticalAlignment="Center" Margin="20,0" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="kivi writes" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="Aaditya Kshatriya" Margin="0,4,0,0"
                                           FontFamily="{DynamicResource FontBody}" FontSize="17"
                                           Foreground="{DynamicResource InkPrimary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- teach disclosure -->
                <Border x:Name="TeachCard" Margin="0,16,0,0" CornerRadius="8"
                        BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="16,14"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource AnnotationColor}" Opacity="0.12" />
                                </Border.Background>
                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Annotation}" FontSize="16" />
                            </Border>
                            <TextBlock Text="teach kivi a term" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontBody}" FontSize="15" Foreground="{DynamicResource InkPrimary}" />
                        </StackPanel>
                    </Button>
                </Border>

                <StackPanel x:Name="ListHost" Margin="0,22,0,0" />
                <Button x:Name="ShowMore" Style="{StaticResource TextButton}" Foreground="{DynamicResource Accent}"
                        HorizontalAlignment="Left" Margin="8,14,0,0" Click="ShowMore_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

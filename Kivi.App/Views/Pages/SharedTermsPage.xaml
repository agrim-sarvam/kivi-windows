<UserControl x:Class="Kivi.App.Views.Pages.SharedTermsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Kivi.App.Controls.Shell">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1068" Margin="44,0,44,96">
            <StackPanel>
                <shell:PageHeader Margin="0,44,0,0"
                    Title="shared terms"
                    Subtitle="a team dictionary — the names, product words, and jargon everyone in your workspace shares." />

                <!-- annotation-tinted banner -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,0">
                    <Border.Background>
                        <SolidColorBrush Color="{DynamicResource AnnotationColor}" Opacity="0.08" />
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="{DynamicResource AnnotationColor}" Opacity="0.26" />
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Annotation}"
                                 VerticalAlignment="Top" Margin="0,6,10,0" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource InkSecondary}"
                                   FontFamily="{DynamicResource FontBody}" FontSize="13" TextWrapping="Wrap"
                                   Text="team space, v1 — these resolve automatically while any member dictates, kept separate from your personal dictionary. adding &amp; editing arrives with the shared store; members &amp; roles live in settings › org &amp; workspace." />
                    </Grid>
                </Border>

                <!-- controls -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="50" Background="{DynamicResource Surface2}" CornerRadius="8"
                            BorderBrush="{DynamicResource Hairline}" BorderThickness="1" Padding="15,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <shell:SearchIcon Size="16" Foreground="{DynamicResource InkTertiary}" VerticalAlignment="Center" />
                            <TextBlock Text="search shared terms" Margin="13,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource InkTertiary}"
                                       FontFamily="{DynamicResource FontBody}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource InkTertiary}"
                               FontFamily="{DynamicResource FontBody}" FontSize="14" />
                </Grid>

                <StackPanel x:Name="ListHost" Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

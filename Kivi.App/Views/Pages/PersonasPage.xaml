<UserControl x:Class="Kivi.App.Views.Pages.PersonasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Kivi.App.Controls.Shell">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="980" Margin="26,0,26,150">
            <StackPanel>
                <!-- title-only header with cloth-red italic "app" -->
                <StackPanel Margin="0,44,0,0">
                    <Grid HorizontalAlignment="Left">
                        <shell:HighlightSweep Fill="{DynamicResource AccentWash}" Height="12"
                                              VerticalAlignment="Bottom" Margin="-2,0,-2,1" />
                        <TextBlock FontFamily="{DynamicResource FontSerif}" FontWeight="Medium" FontSize="30"
                                   Foreground="{DynamicResource InkPrimary}" Padding="2,0">
                            <Run Text="how you sound, app by " /><Run x:Name="ClothWord" Text="app" FontStyle="Italic" />
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- your apps -->
                <StackPanel Margin="0,30,0,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="your apps" FontFamily="{DynamicResource FontSerif}" FontWeight="Medium"
                                   FontSize="22" Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Left" />
                        <Border Height="1" Background="{DynamicResource Hairline}" Margin="90,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="AppList" />
                </StackPanel>

                <!-- code switching -->
                <Grid Margin="0,42,0,0" MinHeight="52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="non-english words" FontFamily="{DynamicResource FontBody}" FontSize="15"
                                   Foreground="{DynamicResource InkPrimary}" />
                        <TextBlock Text="transliteration everywhere — &quot;let's meet kal at 8&quot;" Margin="0,3,0,0"
                                   FontFamily="{DynamicResource FontBody}" FontSize="13" Foreground="{DynamicResource InkTertiary}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Hairline}"
                            BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource Accent}" CornerRadius="6" Padding="12,5">
                                <TextBlock Text="transliteration" FontSize="12" Foreground="{DynamicResource Canvas}" />
                            </Border>
                            <Border CornerRadius="6" Padding="12,5">
                                <TextBlock Text="indic characters" FontSize="12" Foreground="{DynamicResource InkSecondary}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- your styles -->
                <Grid Margin="0,42,0,0">
                    <TextBlock Text="your styles" FontFamily="{DynamicResource FontSerif}" FontWeight="Medium"
                               FontSize="22" Foreground="{DynamicResource InkPrimary}" HorizontalAlignment="Left" />
                    <Border Height="1" Background="{DynamicResource Hairline}" Margin="90,0,0,0" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="VoiceCards" Margin="0,6,0,0" />

                <!-- actions -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Hairline}"
                            BorderThickness="1" CornerRadius="8" Height="34" Padding="16,0">
                        <TextBlock Text="+ new voice" VerticalAlignment="Center" FontFamily="{DynamicResource FontBody}"
                                   FontSize="14" Foreground="{DynamicResource Accent}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="browse recipes" Margin="0,0,16,0" FontSize="13" Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="my recipes" FontSize="13" Foreground="{DynamicResource Accent}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Kivi.App.Views.Shell.Rail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Kivi.App.Controls.Shell">
    <!-- Navigation rail (264 <-> 76). Brand kiwi + wordmark, three groups, footer account+gear. -->
    <Grid x:Name="Root" Background="{DynamicResource Canvas}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
        </Grid.ColumnDefinitions>
        <!-- trailing hairline -->
        <Border Grid.Column="1" Background="{DynamicResource Hairline}" />

        <DockPanel Grid.Column="0" LastChildFill="False">
            <!-- Brand -->
            <Grid DockPanel.Dock="Top" Height="44" Margin="20,46,20,22" x:Name="BrandRow">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="BrandStack">
                    <shell:KiwiMark x:Name="Kiwi" HeightPx="20" Cols="20" VerticalAlignment="Center" />
                    <TextBlock x:Name="Wordmark" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource FontSerif}" FontWeight="Medium"
                               FontSize="26" Foreground="{DynamicResource InkPrimary}">
                        <Run Text="kiv" /><Run Text="i" Foreground="{DynamicResource Accent}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Groups host -->
            <StackPanel DockPanel.Dock="Top" x:Name="GroupsHost" />

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="16,0,16,14" Height="44" x:Name="FooterRow">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource Accent}"
                            BorderBrush="{DynamicResource Hairline}" BorderThickness="2.5">
                        <TextBlock Text="–" Foreground="{DynamicResource Canvas}"
                                   FontFamily="{DynamicResource FontBody}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="AccountMeta" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="sign in" FontFamily="{DynamicResource FontBody}"
                                   FontWeight="Medium" FontSize="13" Foreground="{DynamicResource InkPrimary}" />
                        <TextBlock Text="kivi" FontFamily="{DynamicResource FontBody}"
                                   FontSize="12" Foreground="{DynamicResource InkTertiary}" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="GearBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="30" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="Gear_Click" ToolTip="settings">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="gb" Background="{TemplateBinding Background}" CornerRadius="15">
                                <shell:RailIcon x:Name="gi" Icon="Gear" Size="16"
                                                Foreground="{DynamicResource InkSecondary}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="gb" Property="Background" Value="{DynamicResource AccentWash}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>

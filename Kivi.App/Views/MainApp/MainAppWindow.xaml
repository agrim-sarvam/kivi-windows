<!-- Kivi.App/Views/MainApp/MainAppWindow.xaml -->
<!-- The "main app" window: a sidebar (record/history/personas/presets/memory/analytics/
     leaderboard/settings nav, usage meter, account footer) plus a content Frame. Record,
     History, Analytics, and Settings are real, end-to-end pages. Personas/Presets/Memory
     are real, navigable pages too, but are backed by in-memory-only mock data (see
     WorkspaceMockData; no persistence, no real backend wiring, per the design spec's
     deliberate scope split. Only "leaderboard" remains a non-interactive stub. -->
<Window
    x:Class="Kivi.App.Views.MainApp.MainAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kivi.App.Views.MainApp">

    <Grid Background="{ThemeResource KiviSurfaceAltBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{ThemeResource KiviSurfaceBrush}"
                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="20,20,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wordmark + collapse affordance -->
                <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/Assets/Icons/kivi-mask.png" Width="18" Height="24"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="kivi" VerticalAlignment="Center"
                               FontFamily="{ThemeResource KiviWordmarkFontFamily}"
                               FontSize="20" Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                    <FontIcon Grid.Column="2" Glyph="&#xE700;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                </Grid>

                <!-- Primary nav: record / history -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,20">
                    <local:SidebarNavItem x:Name="NavRecord" Glyph="&#xE720;" Label="record" Click="OnNavRecord"/>
                    <local:SidebarNavItem x:Name="NavHistory" Glyph="&#xE81C;" Label="history" Click="OnNavHistory"/>
                </StackPanel>

                <!-- Workspace section: personas/presets/memory are real pages backed by
                     in-memory mock data (WorkspaceMockData); analytics is real end-to-end;
                     leaderboard remains a non-interactive stub (out of scope). -->
                <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Top">
                    <TextBlock Text="WORKSPACE" Margin="12,0,0,6"
                               FontFamily="{ThemeResource KiviMonoFontFamily}"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <local:SidebarNavItem x:Name="NavPersonas" Glyph="&#xE70F;" Label="personas" Click="OnNavPersonas"/>
                    <local:SidebarNavItem x:Name="NavPresets" Glyph="&#xE8FD;" Label="presets" Click="OnNavPresets"/>
                    <local:SidebarNavItem x:Name="NavMemory" Glyph="&#xE710;" Label="memory" Click="OnNavMemory"/>
                    <local:SidebarNavItem x:Name="NavAnalytics" Glyph="&#xE9D9;" Label="analytics" Click="OnNavAnalytics"/>
                    <local:SidebarNavItem Glyph="&#xE9F1;" Label="leaderboard" IsStub="True"/>
                </StackPanel>

                <!-- Usage meter -->
                <StackPanel Grid.Row="3" Spacing="6" Margin="4,0,4,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="monthly usage" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="11.5" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="1,170/20,000 words" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="11.5" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    </Grid>
                    <Border Height="4" CornerRadius="2" Background="{ThemeResource KiviStrokeBrush}">
                        <Border HorizontalAlignment="Left" Width="16" Height="4" CornerRadius="2"
                                Background="{ThemeResource KiviAccentBrush}"/>
                    </Border>
                    <TextBlock Text="renews 1 aug" FontFamily="{ThemeResource KiviFontFamily}"
                               FontSize="11" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                </StackPanel>

                <!-- Account footer -->
                <Grid Grid.Row="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                            Background="{ThemeResource KiviBrandInkBrush}">
                        <TextBlock Text="n" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{ThemeResource KiviFontFamily}" FontSize="13"
                                   Foreground="{ThemeResource KiviOnBrandBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Nishk Davawala" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="12.5" Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        <TextBlock Text="nishk@sarvam.ai" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="11" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE713;" FontSize="15" VerticalAlignment="Center"
                              Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                </Grid>

                <!-- Settings: pinned at the very bottom of the sidebar, below the account footer. -->
                <local:SidebarNavItem x:Name="NavSettings" Grid.Row="5" Glyph="&#xE713;" Label="settings"
                                      Click="OnNavSettings" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Frame x:Name="ContentFrame" Grid.Column="1"/>
    </Grid>
</Window>

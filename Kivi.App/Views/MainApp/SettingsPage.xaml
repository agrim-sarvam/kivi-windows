<!-- Kivi.App/Views/MainApp/SettingsPage.xaml -->
<!-- The always-available Settings destination (sidebar + tray), distinct from onboarding's
     ConfigPage which stays as the first-run flow. Every control here persists immediately
     via ConfigViewModel (no terminal "Done" step; Settings is always-editable). Adds the
     hotkeys/languages/behavior/privacy controls from the mockup that ConfigPage intentionally
     omits (hey-kivi hotkey, press-and-hold delay, incognito dictation, sound on paste,
     clear-all-history). -->
<Page
    x:Class="Kivi.App.Views.MainApp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kivi.App.Controls"
    Background="{ThemeResource KiviSurfaceAltBrush}">
    <ScrollViewer Padding="32,28,32,28">
        <StackPanel Width="560" HorizontalAlignment="Left" Spacing="16">

            <TextBlock Text="settings" FontFamily="{ThemeResource KiviFontFamily}"
                       FontSize="{ThemeResource KiviFontSizeTitle}"
                       FontWeight="{ThemeResource KiviFontWeightSemibold}"
                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>

            <!-- Hotkeys card -->
            <Border Style="{StaticResource KiviCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Dictation hotkey" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="hold this key to dictate" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <controls:HotkeyCaptureBox x:Name="HotkeyBox" Grid.Column="1"
                                Background="{ThemeResource KiviSurfaceAltBrush}"
                                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                                CornerRadius="{ThemeResource KiviRadiusSm}"
                                Foreground="{ThemeResource KiviTextPrimaryBrush}"
                                FontFamily="{ThemeResource KiviMonoFontFamily}"
                                FontSize="{ThemeResource KiviFontSizeBody}"
                                Padding="16,10"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Hey-kivi rewrite hotkey" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="hold and speak an edit for what kivi last typed" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <controls:HotkeyCaptureBox x:Name="RewriteHotkeyBox" Grid.Column="1"
                                Background="{ThemeResource KiviSurfaceAltBrush}"
                                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                                CornerRadius="{ThemeResource KiviRadiusSm}"
                                Foreground="{ThemeResource KiviTextPrimaryBrush}"
                                FontFamily="{ThemeResource KiviMonoFontFamily}"
                                FontSize="{ThemeResource KiviFontSizeBody}"
                                Padding="16,10"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Press-and-hold delay" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="how long to hold before dictation starts" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{ThemeResource KiviSurfaceAltBrush}"
                                BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                                CornerRadius="{ThemeResource KiviRadiusSm}" Padding="16,10" VerticalAlignment="Center">
                            <TextBlock x:Name="PressAndHoldDelayText" FontFamily="{ThemeResource KiviMonoFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Language card -->
            <Border Style="{StaticResource KiviCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Transcription language" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        <TextBlock Text="auto-detects by default" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeCaption}"
                                   Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="LanguageChipPanel" Orientation="Horizontal" Spacing="8"/>
                </StackPanel>
            </Border>

            <!-- Behavior card -->
            <Border Style="{StaticResource KiviCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Launch at login" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="start kivi automatically when you sign in" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="LaunchAtLoginToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="OnLaunchAtLoginToggled"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Screen context" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="read the active app &amp; field to match tone" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="ScreenContextToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="OnScreenContextToggled"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Incognito dictation" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="skip saving this dictation to history" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="IncognitoToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="OnIncognitoToggled"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Sound on paste" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeBody}"
                                       FontWeight="{ThemeResource KiviFontWeightMedium}"
                                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                            <TextBlock Text="play a soft sound when text is pasted" FontFamily="{ThemeResource KiviFontFamily}"
                                       FontSize="{ThemeResource KiviFontSizeCaption}"
                                       Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="SoundOnPasteToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="OnSoundOnPasteToggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Privacy card -->
            <Border Style="{StaticResource KiviCardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Privacy" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"
                                   FontWeight="{ThemeResource KiviFontWeightMedium}"
                                   Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
                        <TextBlock Text="dictations are stored locally on this device only" FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeCaption}"
                                   Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="ClearHistoryButton" Click="OnClearHistory"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="{ThemeResource KiviDangerBrush}" BorderThickness="1"
                            CornerRadius="{ThemeResource KiviRadiusSm}" Padding="16,10">
                        <TextBlock Text="Clear all history" Foreground="{ThemeResource KiviDangerBrush}"
                                   FontFamily="{ThemeResource KiviFontFamily}"
                                   FontSize="{ThemeResource KiviFontSizeBody}"/>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

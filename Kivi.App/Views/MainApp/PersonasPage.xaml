<!-- Kivi.App/Views/MainApp/PersonasPage.xaml -->
<!-- UI-only per the design spec: backed by WorkspaceMockData.Personas (in-memory, resets on
     restart). Two-column layout: a left rail of persona pills, and a detail card showing
     the selected persona's assigned apps, tone rules, and attached presets. -->
<Page
    x:Class="Kivi.App.Views.MainApp.PersonasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource KiviSurfaceAltBrush}">
    <Grid Padding="32,28,32,28" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="16">
            <TextBlock Text="personas" FontFamily="{ThemeResource KiviFontFamily}"
                       FontSize="{ThemeResource KiviFontSizeTitle}"
                       FontWeight="{ThemeResource KiviFontWeightSemibold}"
                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
            <StackPanel x:Name="PersonaListPanel" Spacing="2"/>
            <Button x:Name="NewPersonaButton" Content="+ new persona" Click="OnNewPersona"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource KiviRadiusSm}" Padding="12,8"
                    Foreground="{ThemeResource KiviTextSecondaryBrush}"
                    FontFamily="{ThemeResource KiviFontFamily}" FontSize="13"/>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource KiviCardStyle}" Padding="24" VerticalAlignment="Top">
            <StackPanel Spacing="20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DetailNameText" Grid.Column="0" FontSize="18"
                               FontFamily="{ThemeResource KiviFontFamily}"
                               FontWeight="{ThemeResource KiviFontWeightSemibold}"
                               Foreground="{ThemeResource KiviTextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="DeleteButton" Grid.Column="1" Click="OnDeletePersona"
                            Background="Transparent" BorderBrush="{ThemeResource KiviStrokeBrush}" BorderThickness="1"
                            CornerRadius="{ThemeResource KiviRadiusSm}" Padding="12,6">
                        <TextBlock Text="delete persona" Foreground="{ThemeResource KiviDangerBrush}"
                                   FontFamily="{ThemeResource KiviFontFamily}" FontSize="12.5"/>
                    </Button>
                </Grid>

                <Rectangle Height="1" Fill="{ThemeResource KiviStrokeBrush}"/>

                <StackPanel Spacing="10">
                    <TextBlock Text="APPS IN THIS PERSONA" FontFamily="{ThemeResource KiviMonoFontFamily}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <StackPanel x:Name="AssignedAppsPanel" Orientation="Horizontal" Spacing="8"/>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="RULES" FontFamily="{ThemeResource KiviMonoFontFamily}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <StackPanel x:Name="ToneRulesPanel" Spacing="8"/>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="ATTACHED PRESETS" FontFamily="{ThemeResource KiviMonoFontFamily}" FontSize="10.5"
                               FontWeight="SemiBold" Foreground="{ThemeResource KiviTextTertiaryBrush}"/>
                    <StackPanel x:Name="AttachedPresetsPanel" Spacing="8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>

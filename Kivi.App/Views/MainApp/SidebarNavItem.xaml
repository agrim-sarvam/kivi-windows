<!-- Kivi.App/Views/MainApp/SidebarNavItem.xaml -->
<UserControl
    x:Class="Kivi.App.Views.MainApp.SidebarNavItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="Root" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
            Padding="12,8" Background="Transparent" BorderThickness="0" CornerRadius="8"
            Click="OnClick">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle x:Name="AccentBar" Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                       Fill="{ThemeResource KiviAccentBrush}" Opacity="0" VerticalAlignment="Stretch"/>
            <FontIcon x:Name="Icon" Grid.Column="1" FontSize="15" VerticalAlignment="Center"
                      Foreground="{ThemeResource KiviTextSecondaryBrush}"/>
            <TextBlock x:Name="LabelText" Grid.Column="2" VerticalAlignment="Center"
                       FontFamily="{ThemeResource KiviFontFamily}" FontSize="13.5"
                       Foreground="{ThemeResource KiviTextPrimaryBrush}"/>
        </Grid>
    </Button>
</UserControl>

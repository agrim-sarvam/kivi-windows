<Window x:Class="Kivi.App.Views.Auth.SignInScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Kivi"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1210">
    <Grid>
        <Border Width="360" Height="420" CornerRadius="18" Background="#171B18"
                BorderBrush="#2A2F2A" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="kivi" FontSize="28" FontWeight="Bold" Foreground="#E9F2E3"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="sign in to reach the live dictation service"
                           FontSize="13" Foreground="#9AA79A" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <Button x:Name="GoogleButton" Height="44" Click="GoogleButton_Click"
                        Background="#22281F" Foreground="#E9F2E3" BorderThickness="0"
                        FontSize="14" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Sign in with Google"/>
                </Button>

                <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontSize="12" Foreground="#9AA79A"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText" Margin="0,20,0,0" FontSize="12" Foreground="#E08A6B"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                <Button x:Name="SkipButton" Content="skip / use local"
                        Margin="0,32,0,0" HorizontalAlignment="Center"
                        Background="Transparent" Foreground="#6F8A5A" BorderThickness="0"
                        FontSize="12" Cursor="Hand" Click="SkipButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="Kivi.App.Views.Auth.SignInScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to Kivi"
        Width="480" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1210">
    <Window.Resources>
        <Style x:Key="OtpTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#1B201C"/>
            <Setter Property="Foreground" Value="#E9F2E3"/>
            <Setter Property="CaretBrush" Value="#E9F2E3"/>
            <Setter Property="BorderBrush" Value="#2A2F2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Canonical single-line TextBox template. Border.Padding insets the content
                             (do NOT also put Margin on PART_ContentHost — combining Padding-margin
                             with VerticalAlignment + a Disabled vertical scrollbar previously scrolled
                             the single line up out of view, clipping typed text at the top edge).
                             VerticalContentAlignment=Center + a stretched content host with both
                             scrollbars Hidden = text stays vertically centred and fully visible, and
                             the field is not a scroll container.
                             TextElement.Foreground must be set explicitly on the root — the inner text
                             adorner does not visibly inherit TextBox.Foreground through a custom
                             template (text rendered near-black-on-black until this was added). -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <!-- Placeholder (from Tag): shown only while the field is empty. The
                                     Tag values were set but never drawn before, so the fields looked
                                     blank/broken. -->
                                <TextBlock x:Name="Placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#6F7A6A"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Placeholder shows only when empty AND unfocused: the Text="" trigger
                                 turns it on, and the focus trigger (later, so it wins when both are
                                 active) turns it off the moment the field is clicked/focused. -->
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#22281F"/>
            <Setter Property="Foreground" Value="#E9F2E3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6F8A5A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Width="380" Height="480" CornerRadius="18" Background="#171B18"
                BorderBrush="#2A2F2A" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Margin="32" VerticalAlignment="Center">
                <TextBlock Text="kivi" FontSize="28" FontWeight="Bold" Foreground="#E9F2E3"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="sign in to reach the live dictation service"
                           FontSize="13" Foreground="#9AA79A" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Step 1: email entry + send-code -->
                <StackPanel x:Name="EmailStep">
                    <TextBox x:Name="EmailTextBox" Style="{StaticResource OtpTextBox}"
                             Tag="you@example.com"/>
                    <Button x:Name="SendCodeButton" Content="Send sign-in code"
                            Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                            Click="SendCodeButton_Click"/>
                </StackPanel>

                <!-- Step 2: 6-digit code entry + verify -->
                <StackPanel x:Name="CodeStep" Visibility="Collapsed">
                    <TextBlock x:Name="CodeSentToText" FontSize="12" Foreground="#9AA79A"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="CodeTextBox" Style="{StaticResource OtpTextBox}"
                             Tag="6-digit code" MaxLength="6"/>
                    <Button x:Name="VerifyCodeButton" Content="Verify code"
                            Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                            Click="VerifyCodeButton_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button x:Name="ResendCodeButton" Content="resend code"
                                Style="{StaticResource LinkButton}" Click="ResendCodeButton_Click"/>
                        <TextBlock Text="  ·  " FontSize="12" Foreground="#6F8A5A"/>
                        <Button x:Name="UseDifferentEmailButton" Content="use a different email"
                                Style="{StaticResource LinkButton}" Click="UseDifferentEmailButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusText" Margin="0,16,0,0" FontSize="12" Foreground="#9AA79A"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText" Margin="0,16,0,0" FontSize="12" Foreground="#E08A6B"
                           TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

                <Border Height="1" Background="#2A2F2A" Margin="0,24,0,20"/>

                <TextBlock Text="Google sign-in" FontSize="12" Foreground="#6F8A5A"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <!-- Genuinely disabled, not just relabeled: previously clickable despite the
                     "(temporarily unavailable)" label, so clicking it set ErrorText to the
                     return_to-allowlist message, which then sat under the OTP section reading
                     as if the OTP flow itself had failed. IsEnabled=False makes it truly inert
                     and WPF dims it automatically (no separate disabled-style needed). -->
                <Button x:Name="GoogleButton" Height="40" Click="GoogleButton_Click"
                        IsEnabled="False"
                        Background="#1B201C" Foreground="#7C8A7A" BorderThickness="0"
                        FontSize="13" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Opacity="0.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Sign in with Google (temporarily unavailable)" TextWrapping="Wrap" TextAlignment="Center"/>
                </Button>

                <Button x:Name="SkipButton" Content="skip / use local"
                        Margin="0,20,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource LinkButton}" Click="SkipButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

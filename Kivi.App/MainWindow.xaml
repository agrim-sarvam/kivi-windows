<Window x:Class="Kivi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EA">
    <!-- P1 skeleton stub. P5 rebuilds this as the frameless Canon shell (rail + pages) per
         docs/maps/main-window-shell-pages.md. Background is the Canon light canvas token. -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="kivi"
                       FontSize="64"
                       Foreground="#20241F"
                       HorizontalAlignment="Center" />
            <TextBlock Text="P1 skeleton — WPF host + DI wired. Orb, wire, and UI arrive in later phases."
                       FontSize="14"
                       Foreground="#5C6454"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>

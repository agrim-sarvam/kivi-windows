<Window x:Class="Kivi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Kivi.App.Controls.Shell"
        xmlns:views="clr-namespace:Kivi.App.Views.Shell"
        Title="kivi"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}"
        WindowStyle="None" AllowsTransparency="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- RAIL -->
        <views:Rail x:Name="RailView" Grid.Column="0" DataContext="{Binding Nav}" />

        <!-- DETAIL -->
        <Grid Grid.Column="1" Background="{DynamicResource Canvas}" ClipToBounds="True">
            <shell:ShellBackground x:Name="Bg" />

            <!-- draggable titlebar strip -->
            <Border Height="38" VerticalAlignment="Top" Background="Transparent"
                    WindowChrome.IsHitTestVisibleInChrome="False" />

            <!-- window controls top-right -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,8,0" WindowChrome.IsHitTestVisibleInChrome="True" Panel.ZIndex="5">
                <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click" ToolTip="minimize">
                    <Path Data="M0,5 H10" Stroke="{DynamicResource InkSecondary}" StrokeThickness="1.4" />
                </Button>
                <Button Style="{StaticResource WindowControlButton}" Click="MaxRestore_Click" ToolTip="maximize">
                    <Path Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{DynamicResource InkSecondary}"
                          StrokeThickness="1.2" Fill="Transparent" />
                </Button>
                <Button x:Name="CloseBtn" Style="{StaticResource WindowControlButton}" Click="Close_Click" ToolTip="close">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource InkSecondary}" StrokeThickness="1.4" />
                </Button>
            </StackPanel>

            <!-- collapse toggle top-left -->
            <Button x:Name="CollapseToggle" Width="30" Height="26" Margin="8,14,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="5"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="CollapseToggle_Click"
                    ToolTip="collapse sidebar (Ctrl+\)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="{TemplateBinding Background}" CornerRadius="4">
                            <shell:SidebarToggleIcon Size="15" Foreground="{DynamicResource InkTertiary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="{DynamicResource AccentWash}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- page host (hard-cut) -->
            <ContentControl x:Name="PageHost" Panel.ZIndex="1" />
        </Grid>

        <!-- First-run onboarding overlay: spans BOTH columns (covers the rail too) so the user can't
             navigate away mid-onboarding. Hidden by default; MainWindow.ShowOnboarding() fills it. -->
        <ContentControl x:Name="OnboardingHost" Grid.Column="0" Grid.ColumnSpan="2"
                        Panel.ZIndex="50" Visibility="Collapsed" />
    </Grid>
</Window>

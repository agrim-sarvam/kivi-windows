<Window x:Class="Kivi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi Setup"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="True"
        FontFamily="{StaticResource FontBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Rounded Canon canvas shell with a hairline edge. -->
    <Border CornerRadius="16" Background="{StaticResource Canvas}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar (drag region + chrome buttons) ===== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="kivi" FontFamily="{StaticResource FontDisplay}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center" />
                    <TextBlock Text="setup" FontSize="13" Margin="7,1,0,0"
                               Foreground="{StaticResource InkTertiary}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                    <Button x:Name="MinButton" Style="{StaticResource ChromeButton}"
                            Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="MinButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButton}"
                            Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== State host ===== -->
            <Grid Grid.Row="1" Margin="40,4,40,34">

                <!-- ===== WELCOME ===== -->
                <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center">
                    <Image Source="Assets/icon.png" Width="72" Height="72"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="kivi" FontFamily="{StaticResource FontDisplay}"
                               FontSize="40" FontWeight="Bold" Foreground="{StaticResource InkPrimary}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="hold-to-talk dictation for windows" FontSize="15"
                               Foreground="{StaticResource InkSecondary}" Margin="0,4,0,0" />
                    <TextBlock Text="installs to your user folder · no admin needed" FontSize="12"
                               Foreground="{StaticResource InkTertiary}" Margin="0,14,0,0" />

                    <StackPanel Margin="0,20,0,0">
                        <CheckBox x:Name="DesktopShortcutCheck" Style="{StaticResource KiviCheckBox}"
                                  Content="desktop shortcut" IsChecked="True" />
                        <CheckBox x:Name="LaunchAtLoginCheck" Style="{StaticResource KiviCheckBox}"
                                  Content="launch kivi at login" IsChecked="False" Margin="0,12,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="WelcomeNote" FontSize="12" Foreground="{StaticResource StateError}"
                               Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}"
                            Content="Install" HorizontalAlignment="Left" Margin="0,22,0,0"
                            Click="InstallButton_Click" />
                </StackPanel>

                <!-- ===== PROGRESS ===== -->
                <StackPanel x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="Assets/icon.png" Width="56" Height="56"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="ProgressHeadline" Text="installing kivi"
                               FontFamily="{StaticResource FontDisplay}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource InkPrimary}" Margin="0,16,0,0" />
                    <Border Margin="0,22,0,0" Height="8" CornerRadius="4"
                            Background="{StaticResource Surface2}">
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Height="8"
                                CornerRadius="4" Background="{StaticResource Accent}" />
                    </Border>
                    <TextBlock x:Name="ProgressStatus" Text="preparing…" FontSize="13"
                               Foreground="{StaticResource InkSecondary}" Margin="0,12,0,0" />
                </StackPanel>

                <!-- ===== DONE ===== -->
                <StackPanel x:Name="DonePanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="Assets/icon.png" Width="72" Height="72"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="DoneHeadline" Text="kivi is ready"
                               FontFamily="{StaticResource FontDisplay}" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource InkPrimary}" Margin="0,16,0,0" />
                    <TextBlock x:Name="DoneSub" Text="hold your hotkey and start talking."
                               FontSize="15" Foreground="{StaticResource InkSecondary}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}"
                                Content="Launch kivi" Click="LaunchButton_Click" />
                        <Button x:Name="DoneCloseButton" Style="{StaticResource GhostButton}"
                                Content="Close" Margin="12,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== UNINSTALL CONFIRM ===== -->
                <StackPanel x:Name="UninstallPanel" VerticalAlignment="Center" Visibility="Collapsed">
                    <Image Source="Assets/icon.png" Width="72" Height="72"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="remove kivi?" FontFamily="{StaticResource FontDisplay}"
                               FontSize="34" FontWeight="Bold" Foreground="{StaticResource InkPrimary}"
                               Margin="0,16,0,0" />
                    <TextBlock Text="this removes kivi and its shortcuts from your user account."
                               FontSize="14" Foreground="{StaticResource InkSecondary}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <Button x:Name="ConfirmUninstallButton" Style="{StaticResource PrimaryButton}"
                                Content="Remove kivi" Click="ConfirmUninstallButton_Click" />
                        <Button x:Name="CancelUninstallButton" Style="{StaticResource GhostButton}"
                                Content="Cancel" Margin="12,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Kivi.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kivi.Core\Kivi.Core.csproj" />
    <ProjectReference Include="..\Kivi.Platform\Kivi.Platform.csproj" />
  </ItemGroup>

  <!-- P2: consumes golden-frames/*.json (copied from _reference/.../test/golden-frames/)
       as the engine-parity oracle. -->
  <ItemGroup>
    <None Include="golden-frames\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

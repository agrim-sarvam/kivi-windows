<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kivi.Core</RootNamespace>
    <!-- Kivi.Core is pure, UI/OS-free logic (engine, wire, tokens, contracts, planner).
         Targets net8.0-windows only for a few Win-specific primitives if needed; no WPF/UI refs. -->
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>

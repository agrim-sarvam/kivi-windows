<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kivi.Platform</RootNamespace>
    <!-- Windows-native seams (P/Invoke, WASAPI, DPAPI, layered window). Implements Kivi.Core.Contracts. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WindowsForms enabled for NotifyIcon (tray) per MASTER-PLAN §4. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kivi.Core\Kivi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
